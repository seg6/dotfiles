#!/usr/bin/env sh
set -eu

root=$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd)
config_home=${XDG_CONFIG_HOME:-"$HOME/.config"}
bin_dir=$HOME/.local/bin

for command in qs go dotdrop systemctl swaymsg; do
    if ! command -v "$command" >/dev/null 2>&1; then
        printf 'overprint: missing dependency: %s\n' "$command" >&2
        exit 1
    fi
done

build=$(mktemp -d)
trap 'rm -rf "$build"' EXIT HUP INT TERM
go -C "$root/tools/cli" build -o "$build/theme" ./cmd/theme
go -C "$root/tools/cli" build -o "$build/ws" ./cmd/ws

dotdrop --cfg="$root/config.yaml" --profile=arch install --force --nodiff \
    f_sway_config f_helix_config f_kitty_config f_kitty_fonts f_kitty_header f_kitty_tab_bar f_tmux_config \
    f_systemd_sway_session_target f_systemd_dotfiles_shell f_systemd_overprint \
    d_overprint f_bin_desktop_shell f_bin_desktop_menu

install -d "$bin_dir" "$config_home/dotfiles"
install -m 755 "$build/theme" "$bin_dir/theme"
install -m 755 "$build/ws" "$bin_dir/ws"
printf '%s\n' "$root" >"$config_home/dotfiles/root"
systemctl --user daemon-reload
dbus-update-activation-environment --systemd DISPLAY WAYLAND_DISPLAY SWAYSOCK I3SOCK XDG_CURRENT_DESKTOP XDG_SESSION_TYPE
# Keep generated icon assets in the config tree and expose them to GTK/Qt.
install -d "${XDG_DATA_HOME:-$HOME/.local/share}/icons"
icons="${XDG_DATA_HOME:-$HOME/.local/share}/icons/Overprint"
if [ ! -e "$icons" ] && [ ! -L "$icons" ]; then
    ln -s "$config_home/dotfiles/icons/Overprint" "$icons"
fi
PATH="$bin_dir:$PATH" DOTFILES_DIR="$root" "$bin_dir/theme" use overprint
printf '%s\n' 'Overprint is active.'
