#!/usr/bin/env python3
"""Install Spicetify, for the Spotify theme, into the user's own data directory."""
import hashlib
import json
import os
from pathlib import Path
import tarfile
import urllib.request

home = Path.home()
cache = Path(os.environ.get('XDG_CACHE_HOME', home / '.cache')) / 'dotfiles/overprint'
share = Path(os.environ.get('XDG_DATA_HOME', home / '.local/share'))
cache.mkdir(parents=True, exist_ok=True)


def download(url, target):
    if not target.exists():
        temporary = target.with_suffix(target.suffix + '.part')
        urllib.request.urlretrieve(url, temporary)
        temporary.replace(target)


version = '2.45.3'
metadata = json.load(urllib.request.urlopen('https://api.github.com/repos/spicetify/cli/releases/tags/v' + version))
asset = next(a for a in metadata['assets'] if a['name'] == f'spicetify-{version}-linux-amd64.tar.gz')
archive = cache / asset['name']
download(asset['browser_download_url'], archive)
digest = 'sha256:' + hashlib.sha256(archive.read_bytes()).hexdigest()
if digest != asset['digest']:
    raise SystemExit('Spicetify release checksum mismatch')
vendor = share / 'dotfiles/spicetify'
vendor.mkdir(parents=True, exist_ok=True)
with tarfile.open(archive) as package:
    package.extractall(vendor, filter='data')
bin_dir = home / '.local/bin'
bin_dir.mkdir(parents=True, exist_ok=True)
link = bin_dir / 'spicetify'
if link.is_symlink(): link.unlink()
if not link.exists(): link.symlink_to(vendor / 'spicetify')
print('Installed Spicetify', version, '(theme activation is separate)')
