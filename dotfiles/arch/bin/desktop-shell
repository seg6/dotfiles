#!/usr/bin/env sh
set -eu

case ${1:-start} in
    stop)
        exec systemctl --user stop overprint.service waybar.service mako.service
        ;;
    start | reload) ;;
    *) printf '%s\n' 'usage: desktop-shell [start|reload|stop]' >&2; exit 2 ;;
esac

backend=classic
selection=${XDG_CONFIG_HOME:-"$HOME/.config"}/dotfiles/shell
if [ -r "$selection" ]; then
    IFS= read -r backend <"$selection" || true
fi

if [ "$backend" = overprint ] && command -v qs >/dev/null 2>&1; then
    systemctl --user stop waybar.service mako.service
    systemctl --user start overprint.service
else
    systemctl --user stop overprint.service
    systemctl --user reload-or-restart waybar.service mako.service
fi
