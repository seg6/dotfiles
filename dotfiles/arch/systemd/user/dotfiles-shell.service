[Unit]
Description=Selected dotfiles desktop shell
PartOf=sway-session.target graphical-session.target
After=graphical-session.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=%h/.local/bin/desktop-shell start
ExecReload=%h/.local/bin/desktop-shell reload
ExecStop=%h/.local/bin/desktop-shell stop
