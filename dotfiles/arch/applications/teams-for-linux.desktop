[Desktop Entry]
Type=Application
Name=Microsoft Teams for Linux
Comment=Unofficial Microsoft Teams client for Linux.
GenericName=Teams
Exec=teams-for-linux --gtk-version=3 --ozone-platform=wayland --enable-features=WebRTCPipeWireCapturer %U
TryExec=teams-for-linux
Icon=teams-for-linux
MimeType=x-scheme-handler/msteams;
Categories=Network;Chat;InstantMessaging;
Terminal=false
StartupNotify=true
